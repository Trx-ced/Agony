local function getTorso(character)
	if not character then return nil end
	return character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("HumanoidRootPart")
end

local function findLivingCharacterForPlayer(plr)
	local model = Living:FindFirstChild(plr.Name)
	if model and model:IsA("Model") then return model end
	if plr.Character and plr.Character:IsA("Model") then return plr.Character end
	return nil
end

local function clampNum(n, lo, hi)
	if n ~= n then return lo end
	if n < lo then return lo end
	if n > hi then return hi end
	return n
end

local function parseSize(xText, yText, zText)
	local x = tonumber(xText) or 8
	local y = tonumber(yText) or 10
	local z = tonumber(zText) or 4
	x = clampNum(x, 1, 100)
	y = clampNum(y, 1, 100)
	z = clampNum(z, 1, 100)
	return Vector3.new(x, y, z)
end

local function cacheOriginal(torso)
	if not torso or not torso:IsA("BasePart") then return end
	if original[torso] then return end
	original[torso] = {
		size = torso.Size,
		transparency = torso.Transparency,
		canCollide = torso.CanCollide,
		canTouch = torso.CanTouch,
		canQuery = torso.CanQuery,
		massless = torso.Massless,
	}
end

local function applyHitbox(torso, sizeVec)
	if not torso or not torso:IsA("BasePart") then return end
	cacheOriginal(torso)
	torso.Size = sizeVec
	torso.Transparency = 1
	torso.CanCollide = false
	torso.CanTouch = false
	torso.CanQuery = false
	torso.Massless = true
end

local function revertTorso(torso)
	local data = torso and original[torso]
	if not data then return end
	torso.Size = data.size
	torso.Transparency = data.transparency
	torso.CanCollide = data.canCollide
	torso.CanTouch = data.canTouch
	torso.CanQuery = data.canQuery
	torso.Massless = data.massless
	original[torso] = nil
end

local function clearHighlights(map)
	for k, h in pairs(map) do
		if h then h:Destroy() end
		map[k] = nil
	end
end

local function setHighlight(map, torso, nameTag, fillT, outlineT)
	if not torso then return end
	if map[torso] then return end
	local h = Instance.new("Highlight")
	h.Name = nameTag
	h.Adornee = torso
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.FillTransparency = fillT
	h.OutlineTransparency = outlineT
	h.Parent = torso
	map[torso] = h
end

