local function revertSelectedOnly()
	clearHighlights(selectedHighlights)
	for plr, torso in pairs(selectedTorso) do
		if torso and torso.Parent then
			revertTorso(torso)
		end
		selectedTorso[plr] = nil
	end
end

local function revertAllApplied()
	clearHighlights(allHighlights)
	for torso in pairs(original) do
		if torso and torso.Parent then
			revertTorso(torso)
		else
			original[torso] = nil
		end
	end
end

local function applySelected(sizeVec)
	revertSelectedOnly()
	if not enabledSelected then return end
	for plr in pairs(selectedPlayers) do
		if plr ~= LocalPlayer then
			local char = findLivingCharacterForPlayer(plr)
			local torso = char and getTorso(char)
			if torso and torso:IsA("BasePart") then
				selectedTorso[plr] = torso
				applyHitbox(torso, sizeVec)
				setHighlight(selectedHighlights, torso, "Cheddar_SelectedTorso", 0.65, 0.1)
			end
		end
	end
end

local function applyAll(sizeVec)
	clearHighlights(allHighlights)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = findLivingCharacterForPlayer(plr)
			local torso = char and getTorso(char)
			if torso and torso:IsA("BasePart") then
				applyHitbox(torso, sizeVec)
				setHighlight(allHighlights, torso, "Cheddar_AllTorso", 0.78, 0.25)
			end
		end
	end
end

local function commitSize()
	local v = parseSize(xBox.Text, yBox.Text, zBox.Text)
	xBox.Text = tostring(v.X)
	yBox.Text = tostring(v.Y)
	zBox.Text = tostring(v.Z)
	if enabledAll then
		revertAllApplied()
		applyAll(v)
	elseif enabledSelected then
		applySelected(v)
	end
end

local function setSelectedMode(state)
	enabledSelected = state
	toggleSelected.Text = enabledSelected and "SEL: ON" or "SEL: OFF"
	toggleSelected.BackgroundColor3 = enabledSelected and Color3.fromRGB(60, 130, 85) or Color3.fromRGB(120, 52, 52)
	if enabledSelected then
		enabledAll = false
		toggleAll.Text = "ALL: OFF"
		toggleAll.BackgroundColor3 = Color3.fromRGB(120, 52, 52)
		clearHighlights(allHighlights)
		applySelected(parseSize(xBox.Text, yBox.Text, zBox.Text))
	else
		revertSelectedOnly()
	end
end

local function setAllMode(state)
	enabledAll = state
	toggleAll.Text = enabledAll and "ALL: ON" or "ALL: OFF"
	toggleAll.BackgroundColor3 = enabledAll and Color3.fromRGB(60, 130, 85) or Color3.fromRGB(120, 52, 52)
	if enabledAll then
		enabledSelected = false
		toggleSelected.Text = "SEL: OFF"
		toggleSelected.BackgroundColor3 = Color3.fromRGB(120, 52, 52)
		revertSelectedOnly()
		revertAllApplied()
		applyAll(parseSize(xBox.Text, yBox.Text, zBox.Text))
	else
		revertAllApplied()
	end
end

local function stylePlayerButton(btn, isSel)
	local stroke = btn:FindFirstChild("Stroke")
	if stroke then
		stroke.Color = isSel and Color3.fromRGB(130, 88, 255) or Color3.fromRGB(28, 28, 34)
		stroke.Thickness = isSel and 2 or 1
	end
	btn.Text = (isSel and "  ✓ " or "  ") .. btn.Name
end

local function filterButtons()
	local q = string.lower(searchBox.Text or "")
	for plr, btn in pairs(buttons) do
		if btn and btn.Parent then
			local name = string.lower(plr.Name)
			btn.Visible = (q == "") or (string.find(name, q, 1, true) ~= nil)
		end
	end
	refreshCanvas()
end

local function toggleSelect(plr)
	if plr == LocalPlayer then return end
	if selectedPlayers[plr] then
		selectedPlayers[plr] = nil
	else
		selectedPlayers[plr] = true
	end
	local btn = buttons[plr]
	if btn then
		stylePlayerButton(btn, selectedPlayers[plr] == true)
	end
	updateSelectedText()
	if enabledSelected and not enabledAll then
		applySelected(parseSize(xBox.Text, yBox.Text, zBox.Text))
	end
end

local function makePlayerButton(plr)
	local b = Instance.new("TextButton")
	b.Name = plr.Name
	b.Size = UDim2.new(1, 0, 0, 32)
	b.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamSemibold
	b.TextSize = 13
	b.TextColor3 = Color3.fromRGB(240, 240, 245)
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.AutoButtonColor = false
	b.Parent = scroll

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = b

	local s = Instance.new("UIStroke")
	s.Name = "Stroke"
	s.Thickness = 1
	s.Color = Color3.fromRGB(28, 28, 34)
	s.Parent = b

	stylePlayerButton(b, selectedPlayers[plr] == true)

	b.MouseButton1Click:Connect(function()
		toggleSelect(plr)
	end)

	return b
end

local function rebuildList()
	for plr, btn in pairs(buttons) do
		if btn then btn:Destroy() end
		buttons[plr] = nil
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			buttons[plr] = makePlayerButton(plr)
		end
	end
	filterButtons()
	updateSelectedText()
end

local function removePlayer(plr)
	local btn = buttons[plr]
	if btn then
		btn:Destroy()
		buttons[plr] = nil
	end
	selectedPlayers[plr] = nil
	local torso = selectedTorso[plr]
	if torso then
		if selectedHighlights[torso] then
			selectedHighlights[torso]:Destroy()
			selectedHighlights[torso] = nil
		end
		revertTorso(torso)
		selectedTorso[plr] = nil
	end
	updateSelectedText()
	filterButtons()
end

local function hookCharacterAdded(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(0.25)
		if enabledAll or enabledSelected then
			commitSize()
		end
	end)
end

